# Persistent PostgreSQL database. Keep this outside the application directory.
# Use an existing PostgreSQL login role; Homebrew commonly uses your macOS username.
DATABASE_URL=postgresql://your-local-role@localhost:5432/studio_k2_admin

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
ADMIN_ORIGIN=http://localhost:5173
PUBLIC_SITE_ORIGIN=http://localhost:5174
PORT=3001

# Local default may be relative; production must use a persistent absolute path.
UPLOAD_ROOT=./var/uploads
